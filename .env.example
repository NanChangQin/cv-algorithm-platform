# true 时开放 /docs 接口文档，只在本地开发时打开
CV_PLATFORM_DEBUG=false
CV_PLATFORM_CORS_ORIGINS=["http://localhost:5173"]
CV_PLATFORM_ALGORITHM_MANAGER_URL=http://localhost:8010/api/v1
# 主平台与所有 GPU 节点的 Algorithm Manager 共用的访问令牌（例如 openssl rand -hex 32 生成）。
# 为空时 Manager 不做鉴权，局域网内任何主机都能启停算法容器；节点端口对局域网开放时务必设置。
CV_PLATFORM_MANAGER_API_TOKEN=
CV_PLATFORM_DATA_ROOT=/srv/cv-platform/data
CV_PLATFORM_MODEL_ROOT=/srv/cv-platform/models
CV_PLATFORM_PACKAGE_ROOT=/srv/cv-platform/packages
CV_PLATFORM_BUILD_NETWORK=bridge
ALGORITHM_MANAGER_DOCKER_NETWORK=cv-algorithm-platform_algorithm-runtime
ALGORITHM_MANAGER_HOST_DATA_ROOT=/srv/cv-platform/data
ALGORITHM_MANAGER_HOST_MODEL_ROOT=/srv/cv-platform/models
VITE_API_BASE_URL=/api/v1
CV_PLATFORM_HTTP_PORT=8080
CV_PLATFORM_ADMIN_USERNAME=admin
CV_PLATFORM_ADMIN_PASSWORD=ChangeMe-Before-Deploy-123!
# false：直接以管理员进入平台；公网部署建议改为 true。
CV_PLATFORM_AUTH_ENABLED=false
CV_PLATFORM_SECURE_COOKIES=false
CV_PLATFORM_MEDIA_WORKER_URL=http://localhost:8020
CV_PLATFORM_CAMERA_DEVICE=/dev/video0
CV_PLATFORM_AUTOSCALING_RECONCILE_SECONDS=15
CV_PLATFORM_TASK_WORKER_COUNT=2
CV_PLATFORM_WORKER_POLL_SECONDS=0.5
ALGORITHM_MANAGER_HEALTH_MONITOR_SECONDS=15
ALGORITHM_MANAGER_HEALTH_FAILURE_THRESHOLD=3
ALGORITHM_MANAGER_IDLE_TIMEOUT_SECONDS=1800

# compose.database.yaml sets this to postgres for the Backend container.
# Keep memory only when intentionally running the API without PostgreSQL.
CV_PLATFORM_PERSISTENCE_BACKEND=memory
# compose.database.yaml automatically switches this to postgres.
CV_PLATFORM_QUEUE_BACKEND=local
CV_PLATFORM_POSTGRES_DB=cv_platform
CV_PLATFORM_POSTGRES_USER=cv_platform
CV_PLATFORM_POSTGRES_PASSWORD=ChangeMe-Database-Password
CV_PLATFORM_POSTGRES_HOST=localhost
CV_PLATFORM_POSTGRES_PORT=5432
# Direct URL is optional. If used, URL-encode reserved password characters.
# CV_PLATFORM_DATABASE_URL=postgresql+psycopg://cv_platform:password@localhost:5432/cv_platform
# 每个进程（Backend、Worker）的数据库连接池上限，默认 10
# CV_PLATFORM_DATABASE_POOL_SIZE=10

# Optional compose.monitoring.yaml settings.
CV_PLATFORM_GRAFANA_ADMIN_PASSWORD=ChangeMe-Grafana-Password
CV_PLATFORM_PROMETHEUS_PORT=9090
CV_PLATFORM_GRAFANA_PORT=3000
